[Unit]
Description= PVControl+ - Lectura MUST
After=mysql.service

[Service]
SyslogIdentifier=%N
User=pi
Group=pi
ExecStartPre=/bin/sleep 1
Environment="PYTHONPATH=/home/pi/PVControl+"
ExecStart=/home/pi/PVControl+/env/bin/python3 /home/pi/servicios/PVControl+/must.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
