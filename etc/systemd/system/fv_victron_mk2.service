[Unit]
Description=PVControl+ --> lectura de equipos mk2 y mk3 como victron multiplus
After=mysql.service

[Service]
SyslogIdentifier=%N
User=pi
Group=pi
ExecStartPre=/bin/sleep 1
ExecStart=/home/pi/PVControl+/env/bin/python3 /home/pi/PVControl+/fv_victron_mk2.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
