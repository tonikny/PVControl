[Unit]
Description=FV lectura Central Meteorologica compatible con ECOWITT

After=mysql.service

[Service]
SyslogIdentifier=%N
User=pi
Group=pi
ExecStartPre=/bin/sleep 1
ExecStart=/home/pi/PVControl+/env/bin/python3 /home/pi/PVControl+/fv_ecowitt.py
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
