[Unit]
Description=PVControl+ ADS Capture Service for %i
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/PVControl+
ExecStart=/usr/bin/python3 /home/pi/PVControl+/servicios/fv_ads_single.py %i
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fv_ads_%i

# Environment variables
Environment="LOGLEVEL=INFO"
Environment="PYTHONUNBUFFERED=1"

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/PVControl+ /var/log

# Resource limits
LimitNOFILE=65535
Nice=10

[Install]
WantedBy=multi-user.target
